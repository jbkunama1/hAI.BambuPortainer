# ──────────────────────────────────────────────
# hAI.BambuPortainer – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an!
# ──────────────────────────────────────────────

# ── Bambu Studio ──────────────────────────────
# Externer Port für das Web-Interface (HTTP)
BAMBU_HTTP_PORT=3000
# Externer Port für das Web-Interface (HTTPS)
BAMBU_HTTPS_PORT=3001
# Externer Port für den WebSocket
BAMBU_WS_PORT=8082

# ── BambuBuddy ────────────────────────────────
# Externer Port für das BambuBuddy Web-UI
BAMBU_BUDDY_PORT=8060

# ── Allgemein ─────────────────────────────────
# Benutzer-/Gruppen-ID (an deinen Host-User anpassen!)
PUID=1000
PGID=1000
# Zeitzone
TZ=Europe/Berlin

# ── Bambu Studio: Basic Auth (UNBEDINGT ÄNDERN!) ──
CUSTOM_USER=abc
CUSTOM_PASSWORD=abc

# ── Bambu Studio: Dark Mode ───────────────────
DARK_MODE=true
