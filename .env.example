# ──────────────────────────────────────────────
# hAI.BambuPortainer – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an!
# ──────────────────────────────────────────────

# ── Einziger externer Port ───────────────────────
# Wird nach außen freigegeben (Port 8060)
BAMBU_BUDDY_PORT=8060

# ── Allgemein ─────────────────────────────────
# Benutzer-/Gruppen-ID (an deinen Host-User anpassen!)
PUID=1000
PGID=1000
# Zeitzone
TZ=Europe/Berlin
